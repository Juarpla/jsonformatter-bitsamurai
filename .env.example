# Google AdSense publisher id (e.g. ca-pub-XXXXXXXXXXXXXXXX).
# When unset, AdSlot.astro renders labeled placeholders and makes no
# external requests. See src/config/ads.ts for placement toggles.
PUBLIC_ADSENSE_CLIENT=

# Optional AdSense ad-unit ids (data-ad-slot, from the AdSense dashboard).
# One unit per size: header 468×60 (≥1280px) and 300×50 (<1280px), middle
# 250×250, footer 970×90 (≥1024px) and 300×50 (<1024px). Unset ids render
# the <ins> without data-ad-slot.
PUBLIC_ADSENSE_SLOT_HEADER_468=
PUBLIC_ADSENSE_SLOT_HEADER_300=
PUBLIC_ADSENSE_SLOT_MIDDLE=
PUBLIC_ADSENSE_SLOT_FOOTER_970=
PUBLIC_ADSENSE_SLOT_FOOTER_300=

# Canonical origin of the deployed site (no trailing slash). Every absolute
# URL — canonical link, og:url, JSON-LD, sitemap — derives from it. Override
# when moving to a custom domain; defaults to the workers.dev URL.
PUBLIC_SITE_URL=https://jsonformatter-bitsamurai.juarpla.workers.dev
