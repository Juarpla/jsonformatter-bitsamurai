---
/**
 * Google AdSense slot with layout-safe variants (see DESIGN.md → Components).
 *
 * - Without PUBLIC_ADSENSE_CLIENT: renders a labeled placeholder that reserves
 *   the exact final size of the ad (useful to validate the layout).
 * - With PUBLIC_ADSENSE_CLIENT: renders a manual <ins class="adsbygoogle">
 *   and loads the AdSense library once. Auto Ads are never enabled.
 * - Sizes are fixed (they live in CSS, see global.css) and never change with
 *   ad state: `header` 468×60 (300×50 at 1024–1279px), `middle` 200×200 —
 *   rendered twice via `unit` ('a' top, 'b' bottom; 'b' hides on short
 *   viewports) —, `footer` 728×90.
 */
import { ads, type AdUnit, type AdVariant } from '../config/ads';

interface Props {
  variant: AdVariant;
  /** Middle variant only: which of the two stacked units. */
  unit?: 'a' | 'b';
}

const { variant, unit } = Astro.props;

const labels: Record<AdVariant, string> = {
  header: '468×60 · 300×50 @1024–1279',
  middle: '200×200',
  footer: '728×90',
};

const client = ads.client;
const enabled = ads.placements[variant];
const adUnit: AdUnit = variant === 'middle' ? `middle-${unit ?? 'a'}` : variant;
const slotId = ads.slotIds[adUnit];
---

{
  enabled && (
    <aside
      class:list={['ad-slot', `ad-${variant}`, unit && `ad-middle-${unit}`]}
      aria-label="Advertisement"
    >
      {client ? (
        <ins
          class="adsbygoogle"
          style="display:block"
          data-ad-client={client}
          data-ad-slot={slotId}
        />
      ) : (
        <div class="ad-placeholder">
          <span>Ad</span>
          <small>{labels[variant]}</small>
        </div>
      )}
    </aside>
  )
}

<script>
  // Load the AdSense library once, only when a publisher id is configured.
  const CLIENT = import.meta.env.PUBLIC_ADSENSE_CLIENT as string | undefined;

  if (CLIENT) {
    const existing = document.querySelector<HTMLScriptElement>('script[data-adsense]');
    if (!existing) {
      const script = document.createElement('script');
      script.async = true;
      script.dataset.adsense = 'true';
      script.crossOrigin = 'anonymous';
      script.src = `https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${CLIENT}`;
      document.head.appendChild(script);
    }

    const pushSlots = () => {
      const w = window as unknown as { adsbygoogle?: Record<string, unknown>[] };
      w.adsbygoogle = w.adsbygoogle || [];
      document.querySelectorAll('.adsbygoogle').forEach(() => {
        w.adsbygoogle?.push({});
      });
    };
    if (document.readyState === 'complete') pushSlots();
    else window.addEventListener('load', pushSlots, { once: true });
  }
</script>
