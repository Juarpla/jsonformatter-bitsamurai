---
import Menu from './Menu.astro';

interface Props {
  side: 'left' | 'right';
  docName?: string;
}

const { side, docName = 'untitled' } = Astro.props;
---

<section class="panel" data-panel={side}>
  <div class="panel-chrome">
    <div class="doc-chip">
      <svg class="chip-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M3 12h18M12 3a15 15 0 0 1 0 18 15 15 0 0 1 0-18z"></path></svg>
      <input class="doc-name" type="text" value={docName} spellcheck="false" aria-label={`Document name (${side} panel)`} />
      <svg class="chip-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 3a2.8 2.8 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"></path></svg>
    </div>

    <div class="panel-actions">
      <button class="tb-btn" type="button" data-action="new" data-panel={side} title="New document">
        <svg class="tb-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>
        <span class="tb-label">New</span>
      </button>

      <Menu class="tb-menu">
        <Fragment slot="trigger">
          <svg class="tb-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7z"></path></svg>
          <span class="tb-label">Open</span>
          <svg class="tb-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
        </Fragment>
        <button class="menu-item" type="button" role="menuitem" data-action="open-file" data-panel={side}>
          <svg class="menu-item-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7z"></path></svg>
          Open from disk
        </button>
        <button class="menu-item" type="button" role="menuitem" disabled title="Coming soon">
          <svg class="menu-item-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.8 1.7"></path><path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7"></path></svg>
          Open from URL
        </button>
        <button class="menu-item" type="button" role="menuitem" disabled title="Coming soon">
          <svg class="menu-item-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"></rect><path d="M3 10h18M9 4v16"></path></svg>
          Import CSV
        </button>
      </Menu>

      <Menu class="tb-menu">
        <Fragment slot="trigger">
          <svg class="tb-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path><path d="M17 21v-8H7v8M7 3v5h8"></path></svg>
          <span class="tb-label">Save</span>
          <svg class="tb-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
        </Fragment>
        <button class="menu-item" type="button" role="menuitem" data-action="save-disk" data-panel={side}>
          <svg class="menu-item-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><path d="m7 10 5 5 5-5M12 15V3"></path></svg>
          Save to disk
        </button>
      </Menu>

      <Menu class="tb-menu">
        <Fragment slot="trigger">
          <svg class="tb-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
          <span class="tb-label">Copy</span>
          <svg class="tb-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
        </Fragment>
        <button class="menu-item" type="button" role="menuitem" data-action="copy-formatted" data-panel={side}>Copy formatted</button>
        <button class="menu-item" type="button" role="menuitem" data-action="copy-smart-formatted" data-panel={side}>Copy smart formatted</button>
        <button class="menu-item" type="button" role="menuitem" data-action="copy-compacted" data-panel={side}>Copy compacted</button>
        <button class="menu-item" type="button" role="menuitem" data-action="copy-escaped" data-panel={side}>Copy escaped</button>
        <button class="menu-item" type="button" role="menuitem" data-action="copy-as-is" data-panel={side}>Copy as-is</button>
      </Menu>

      <button class="tb-btn" type="button" data-action="fullscreen" data-panel={side} title="Full screen">
        <svg class="tb-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 3H5a2 2 0 0 0-2 2v3m0 8v3a2 2 0 0 0 2 2h3m8 0h3a2 2 0 0 0 2-2v-3m0-8V5a2 2 0 0 0-2-2h-3"></path></svg>
        <span class="tb-label">Full screen</span>
      </button>
    </div>
  </div>

  <div class="mode-tabs" role="tablist" aria-label={`View mode (${side} panel)`}>
    <button class="mode-tab is-active" type="button" role="tab" aria-selected="true" data-mode="text" data-panel={side}>text</button>
    <button class="mode-tab" type="button" role="tab" aria-selected="false" data-mode="tree" data-panel={side}>tree</button>
    <button class="mode-tab" type="button" role="tab" aria-selected="false" data-mode="table" data-panel={side}>table</button>
  </div>

  <div class="editor-host json-editor-host" data-editor-host={side}></div>

  <footer class="status-bar">
    <span data-status-pos>Line: 1&nbsp;&nbsp;Column: 1</span>
    <span class="status-size" data-status-size></span>
  </footer>
</section>

<style>
  .panel {
    display: flex;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
    background: var(--surface);
  }

  .panel:fullscreen {
    border-radius: 0;
  }

  /* Accent-colored chrome strip (toolbar + doc chip) */
  .panel-chrome {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 4px 16px;
    min-height: var(--toolbar-height);
    padding: 2px 8px;
    background: var(--accent-chrome);
    color: var(--accent-contrast);
  }

  .doc-chip {
    display: flex;
    align-items: center;
    gap: 6px;
    min-height: 36px;
  }

  .chip-icon {
    width: 18px;
    height: 18px;
    opacity: 0.9;
  }

  .doc-name {
    width: 150px;
    padding: 2px 4px;
    border: 0;
    border-radius: var(--radius-sm);
    background: transparent;
    color: inherit;
    font-size: 15px;
  }

  .doc-name:focus {
    background: rgba(0, 0, 0, 0.15);
    outline: none;
  }

  .panel-actions {
    display: flex;
    align-items: center;
    gap: 2px;
    margin-left: auto;
    flex-wrap: wrap;
  }

  .tb-btn,
  .panel-actions .menu-trigger {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 36px;
    padding: 0 10px;
    color: inherit;
    font-size: 15px; /* subhead */
    border-radius: var(--radius-sm);
    white-space: nowrap;
  }

  .tb-btn:hover,
  .panel-actions .menu-trigger:hover {
    background: rgba(0, 0, 0, 0.15);
  }

  .tb-icon {
    width: 17px;
    height: 17px;
  }

  .tb-chevron {
    width: 13px;
    height: 13px;
    opacity: 0.8;
  }

  /* Mode tabs: segmented pills on the accent chrome */
  .mode-tabs {
    display: flex;
    gap: 2px;
    padding: 0 8px;
    background: var(--accent-chrome);
  }

  .mode-tab {
    min-height: 30px;
    padding: 2px 12px;
    color: var(--accent-contrast);
    font-size: 15px;
    border-radius: var(--radius-full, 9999px);
  }

  .mode-tab:hover {
    background: rgba(0, 0, 0, 0.12);
  }

  .mode-tab.is-active {
    background: rgba(0, 0, 0, 0.32);
  }

  /* Status bar */
  .status-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: var(--statusbar-height);
    padding: 0 8px;
    background: var(--surface-secondary);
    color: var(--on-surface-secondary);
    font-size: 13px; /* footnote */
    line-height: 18px;
    border-top: 1px solid var(--separator);
    white-space: pre;
  }

  .status-size {
    font-family: var(--font-mono);
    font-size: 12px;
  }

  /* Toolbars collapse to icons on narrow screens */
  @media (max-width: 1279px) {
    .tb-label {
      display: none;
    }
  }

  @media (max-width: 767px) {
    .doc-name {
      width: 90px;
    }
  }
</style>
