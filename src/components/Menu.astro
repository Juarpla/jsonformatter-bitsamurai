---
/**
 * Accessible dropdown menu primitive.
 * Structure/styles are global (menus appear in both the light navbar and
 * accent-colored toolbars); each usage provides its own trigger + items.
 */
interface Props {
  label?: string;
  align?: 'left' | 'right';
  class?: string;
}

const { label = '', align = 'left', class: className = '' } = Astro.props;
---

<div class:list={['menu', className]} data-align={align}>
  <button class="menu-trigger" type="button" aria-haspopup="menu" aria-expanded="false">
    {label ? <span>{label}</span> : <slot name="trigger" />}
  </button>
  <div class="menu-panel" role="menu" hidden>
    <slot />
  </div>
</div>

<script>
  function setOpen(menu: Element, open: boolean): void {
    menu.classList.toggle('open', open);
    const panel = menu.querySelector<HTMLElement>('.menu-panel');
    const trigger = menu.querySelector<HTMLButtonElement>('.menu-trigger');
    if (panel) panel.hidden = !open;
    trigger?.setAttribute('aria-expanded', String(open));
  }

  function closeAllMenus(): void {
    document.querySelectorAll('.menu.open').forEach((menu) => setOpen(menu, false));
  }

  document.addEventListener('click', (event) => {
    const target = event.target as Element | null;
    if (!target) return;

    const trigger = target.closest('.menu-trigger');
    if (trigger) {
      const menu = trigger.closest('.menu');
      if (!menu) return;
      const wasOpen = menu.classList.contains('open');
      closeAllMenus();
      if (!wasOpen) setOpen(menu, true);
      return;
    }

    // Clicking an item closes menus, unless the item opts out (radio groups).
    const item = target.closest('[role="menuitem"], [role="menuitemradio"]');
    const keepOpen = item?.closest('[data-keep-open]')?.closest('.menu');
    closeAllMenus();
    if (item && keepOpen) setOpen(keepOpen, true);
  });

  document.addEventListener('keydown', (event) => {
    const target = event.target as Element | null;

    if (event.key === 'Escape') {
      const menu = target?.closest('.menu.open');
      closeAllMenus();
      // Return focus to the trigger that owned the open menu.
      menu?.querySelector<HTMLButtonElement>('.menu-trigger')?.focus();
      return;
    }

    if (!target) return;
    const menu = target.closest('.menu');
    if (!menu) return;
    // Links (e.g. mobile "Home") cycle through the menu like buttons do.
    const items = [
      ...menu.querySelectorAll<HTMLElement>('.menu-panel button:not(:disabled), .menu-panel a[href]'),
    ];
    if (items.length === 0) return;

    // ArrowDown on the trigger opens the menu and moves into it.
    if (event.key === 'ArrowDown' && target.closest('.menu-trigger')) {
      event.preventDefault();
      if (!menu.classList.contains('open')) {
        closeAllMenus();
        setOpen(menu, true);
      }
      items[0]?.focus();
      return;
    }

    // Arrows/Home/End cycle through the open menu's items.
    const current = target instanceof HTMLElement && items.includes(target) ? items.indexOf(target) : -1;
    if (current === -1) return;
    let next: number | undefined;
    if (event.key === 'ArrowDown') next = current + 1;
    else if (event.key === 'ArrowUp') next = current - 1;
    else if (event.key === 'Home') next = 0;
    else if (event.key === 'End') next = items.length - 1;
    else return;
    event.preventDefault();
    items[(next + items.length) % items.length]?.focus();
  });

  // Close a menu once focus leaves it entirely (Tab/Shift+Tab away).
  document.addEventListener('focusout', (event) => {
    const menu = (event.target as Element | null)?.closest?.('.menu');
    if (!menu?.classList.contains('open')) return;
    const next = event.relatedTarget as Element | null;
    if (!next || !menu.contains(next)) setOpen(menu, false);
  });
</script>
