---
import Menu from './Menu.astro';
import AdSlot from './AdSlot.astro';
import { ads } from '../config/ads';
---

<header class="navbar">
  <a class="brand" href="/">
    <svg class="brand-mark" viewBox="0 0 128 128" aria-hidden="true">
      <path fill="var(--accent)" d="M128.00 64.00L127.96 83.67L127.86 89.93L127.68 94.47L127.44 98.15L127.12 101.27L126.73 104.01L126.26 106.45L125.73 108.66L125.11 110.67L124.42 112.50L123.65 114.19L122.80 115.74L121.86 117.18L120.83 118.50L119.72 119.72L118.50 120.83L117.18 121.86L115.74 122.80L114.19 123.65L112.50 124.42L110.67 125.11L108.66 125.73L106.45 126.26L104.01 126.73L101.27 127.12L98.15 127.44L94.47 127.68L89.93 127.86L83.67 127.96L64.00 128.00L44.33 127.96L38.07 127.86L33.53 127.68L29.85 127.44L26.73 127.12L23.99 126.73L21.55 126.26L19.34 125.73L17.33 125.11L15.50 124.42L13.81 123.65L12.26 122.80L10.82 121.86L9.50 120.83L8.28 119.72L7.17 118.50L6.14 117.18L5.20 115.74L4.35 114.19L3.58 112.50L2.89 110.67L2.27 108.66L1.74 106.45L1.27 104.01L0.88 101.27L0.56 98.15L0.32 94.47L0.14 89.93L0.04 83.67L0.00 64.00L0.04 44.33L0.14 38.07L0.32 33.53L0.56 29.85L0.88 26.73L1.27 23.99L1.74 21.55L2.27 19.34L2.89 17.33L3.58 15.50L4.35 13.81L5.20 12.26L6.14 10.82L7.17 9.50L8.28 8.28L9.50 7.17L10.82 6.14L12.26 5.20L13.81 4.35L15.50 3.58L17.33 2.89L19.34 2.27L21.55 1.74L23.99 1.27L26.73 0.88L29.85 0.56L33.53 0.32L38.07 0.14L44.33 0.04L64.00 0.00L83.67 0.04L89.93 0.14L94.47 0.32L98.15 0.56L101.27 0.88L104.01 1.27L106.45 1.74L108.66 2.27L110.67 2.89L112.50 3.58L114.19 4.35L115.74 5.20L117.18 6.14L118.50 7.17L119.72 8.28L120.83 9.50L121.86 10.82L122.80 12.26L123.65 13.81L124.42 15.50L125.11 17.33L125.73 19.34L126.26 21.55L126.73 23.99L127.12 26.73L127.44 29.85L127.68 33.53L127.86 38.07L127.96 44.33Z"></path>
      <path d="M48 36 C41 36 41 46 41 52 C41 59 38 62 32 64 C38 66 41 69 41 76 C41 82 41 92 48 92" fill="none" stroke="var(--accent-contrast)" stroke-width="8" stroke-linecap="round" stroke-linejoin="round"></path>
      <path d="M80 36 C87 36 87 46 87 52 C87 59 90 62 96 64 C90 66 87 69 87 76 C87 82 87 92 80 92" fill="none" stroke="var(--accent-contrast)" stroke-width="8" stroke-linecap="round" stroke-linejoin="round"></path>
      <circle cx="64" cy="64" r="12" fill="var(--error)" stroke="var(--accent-contrast)" stroke-width="4"></circle>
    </svg>
    <strong>JSON Formatter</strong>&nbsp;<span>Bit SamurAI</span>
  </a>

  {ads.placements.header && <AdSlot variant="header" />}

  <nav class="navbar-actions" aria-label="Application">
    <Menu align="right">
      <Fragment slot="trigger">
        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="3"></circle>
          <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
        </svg>
        <span class="nav-label">Settings</span>
        <svg class="nav-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
      </Fragment>

      <div class="menu-label">Theme</div>
      <button class="menu-item" type="button" role="menuitemradio" data-theme-choice="system" data-keep-open aria-checked="true">
        <svg class="menu-item-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 3a9 9 0 0 0 0 18z" fill="currentColor" stroke="none"></path></svg>
        Browser default
      </button>
      <button class="menu-item" type="button" role="menuitemradio" data-theme-choice="light" data-keep-open aria-checked="false">
        <svg class="menu-item-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
        Light
      </button>
      <button class="menu-item" type="button" role="menuitemradio" data-theme-choice="dark" data-keep-open aria-checked="false">
        <svg class="menu-item-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
        Dark
      </button>

      <div class="menu-label">Theme color</div>
      <button class="menu-item" type="button" role="menuitemradio" data-accent-choice="blue" data-keep-open aria-checked="true">
        <span class="accent-dot" style="--dot: #007aff;"></span>
        Blue (default)
      </button>
      <button class="menu-item" type="button" role="menuitemradio" data-accent-choice="green" data-keep-open aria-checked="false">
        <span class="accent-dot" style="--dot: #5c7a1e;"></span>
        Green
      </button>
      <button class="menu-item" type="button" role="menuitemradio" data-accent-choice="red" data-keep-open aria-checked="false">
        <span class="accent-dot" style="--dot: #ff3b30;"></span>
        Red
      </button>

      <hr class="menu-separator" />
      <button class="menu-item" type="button" role="menuitem" disabled title="Coming soon">Configure editor</button>
    </Menu>

    <Menu align="right" class="help-menu">
      <Fragment slot="trigger">
        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M9.1 9a3 3 0 0 1 5.8 1c0 2-3 3-3 3"></path><path d="M12 17h.01"></path></svg>
        <span class="nav-label">Help</span>
        <svg class="nav-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
      </Fragment>
      <div class="menu-label">Keyboard shortcuts</div>
      <span class="menu-item help-line"><span>Undo</span><kbd>Ctrl+Z</kbd></span>
      <span class="menu-item help-line"><span>Redo</span><kbd>Ctrl+Shift+Z</kbd></span>
      <span class="menu-item help-line"><span>Search</span><kbd>Ctrl+F</kbd></span>
      <span class="menu-item help-line"><span>Format</span><kbd>Ctrl+Shift+F</kbd></span>
    </Menu>
  </nav>
</header>

<style>
  .navbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: var(--navbar-height);
    padding: 0 16px;
    background: var(--surface);
    border-bottom: 1px solid var(--separator);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--on-surface);
    text-decoration: none;
    font-size: 22px; /* title-2 */
    line-height: 28px;
    white-space: nowrap;
  }

  .brand-mark {
    width: 22px;
    height: 22px;
    flex: none;
    border-radius: var(--radius-lg);
  }

  .brand strong {
    font-weight: 600;
  }

  .brand span {
    color: var(--on-surface-secondary);
    font-weight: 400;
  }

  .navbar-actions {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .navbar-actions .menu-trigger {
    color: var(--on-surface);
    font-size: 17px; /* body */
    border-radius: var(--radius-sm);
    padding: 0 12px;
  }

  .navbar-actions .menu-trigger:hover {
    background: var(--surface-secondary);
  }

  .nav-icon {
    width: 18px;
    height: 18px;
  }

  .nav-chevron {
    width: 14px;
    height: 14px;
    color: var(--on-surface-secondary);
  }

  .help-line {
    cursor: default;
    justify-content: space-between;
    font-family: var(--font-sans);
  }

  .help-line:hover {
    background: transparent;
  }

  .help-line kbd {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--on-surface-secondary);
    background: var(--surface-secondary);
    border: 1px solid var(--separator);
    border-radius: var(--radius-sm);
    padding: 2px 6px;
  }

  @media (max-width: 767px) {
    .nav-label,
    .brand span {
      display: none;
    }
  }
</style>

<script>
  import {
    persistTheme,
    persistAccent,
    currentThemeSetting,
    currentAccentSetting,
    announceAppearance,
    type ThemeSetting,
    type AccentSetting,
  } from '../scripts/appearance';
  import { isMacPlatform } from '../scripts/shortcuts';

  // Show platform-correct modifier labels for the advertised shortcuts.
  if (isMacPlatform()) {
    document.querySelectorAll('.help-line kbd').forEach((el) => {
      el.textContent = (el.textContent ?? '').replace('Ctrl+', '⌘').replace('Shift+', '⇧');
    });
  }

  function syncChecked(): void {
    const theme = currentThemeSetting();
    const accent = currentAccentSetting();
    document.querySelectorAll<HTMLElement>('[data-theme-choice]').forEach((el) => {
      el.setAttribute('aria-checked', String(el.dataset.themeChoice === theme));
    });
    document.querySelectorAll<HTMLElement>('[data-accent-choice]').forEach((el) => {
      el.setAttribute('aria-checked', String(el.dataset.accentChoice === accent));
    });
  }

  document.addEventListener('click', (event) => {
    const target = event.target as Element | null;
    if (!target) return;

    const themeChoice = target.closest<HTMLElement>('[data-theme-choice]');
    if (themeChoice?.dataset.themeChoice) {
      persistTheme(themeChoice.dataset.themeChoice as ThemeSetting);
      syncChecked();
      announceAppearance();
      return;
    }

    const accentChoice = target.closest<HTMLElement>('[data-accent-choice]');
    if (accentChoice?.dataset.accentChoice) {
      persistAccent(accentChoice.dataset.accentChoice as AccentSetting);
      syncChecked();
      announceAppearance();
    }
  });

  syncChecked();
</script>
