---
import EditorPanel from './EditorPanel.astro';
import AdSlot from './AdSlot.astro';
import { ads } from '../config/ads';
---

<div class="workspace" id="workspace">
  <EditorPanel side="left" docName="untitled" />

  <div class="middle" aria-label="Panel tools">
    <div class="middle-controls">
      <div class="ctl-group">
        <span class="ctl-label">Copy</span>
        <div class="ctl-buttons">
          <button type="button" class="ctl-btn" data-action="copy-to-left" title="Copy the right panel to the left panel">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"></path></svg>
          </button>
          <button type="button" class="ctl-btn" data-action="copy-to-right" title="Copy the left panel to the right panel">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg>
          </button>
        </div>
      </div>

      <div class="ctl-group">
        <span class="ctl-label">Transform</span>
        <div class="ctl-buttons">
          <button type="button" class="ctl-btn" disabled title="Coming soon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"></path></svg>
          </button>
          <button type="button" class="ctl-btn" disabled title="Coming soon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg>
          </button>
        </div>
      </div>

      <div class="ctl-group">
        <span class="ctl-label">Differences</span>
        <button type="button" class="ctl-btn compare" disabled title="Coming soon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="2"></rect></svg>
          <span>Compare</span>
        </button>
      </div>
    </div>

    {ads.placements.middle && (
      <div class="ad-group">
        <AdSlot variant="middle" />
      </div>
    )}

    <div class="splitter" data-role="splitter" role="separator" tabindex="0" aria-orientation="vertical" aria-label="Resize panels" aria-valuemin="15" aria-valuemax="85" aria-valuenow="50" title="Drag left or right to change the width of the panels">
      <span class="splitter-dots" aria-hidden="true"><i></i><i></i><i></i></span>
    </div>
  </div>

  <EditorPanel side="right" docName="test" />
</div>

<style>
  .workspace {
    flex: 1;
    display: grid;
    grid-template-columns: 1fr var(--middle-width) 1fr;
    min-height: 0;
  }

  .middle {
    display: flex;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
    border-left: 1px solid var(--separator);
    border-right: 1px solid var(--separator);
    background: var(--background);
  }

  .middle-controls {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    padding: 24px 8px;
  }

  .ctl-group {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    width: 100%;
  }

  .ctl-label {
    font-size: 15px;
    color: var(--on-surface);
  }

  .ctl-buttons {
    display: flex;
    gap: 8px;
  }

  .ctl-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-width: 44px;
    height: 44px;
    background: var(--surface);
    border: 1px solid var(--separator);
    border-radius: var(--radius-md);
    color: var(--on-surface);
    font-size: 15px;
  }

  .ctl-btn svg {
    width: 18px;
    height: 18px;
  }

  .ctl-btn:hover:not(:disabled) {
    background: var(--surface-secondary);
  }

  .ctl-btn:disabled {
    color: var(--on-surface-tertiary);
    cursor: default;
  }

  .compare {
    width: 100%;
    justify-content: center;
  }

  /* Sponsored ad group: reads like a third control group */
  .ad-group {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    width: 100%;
    margin-top: 16px;
  }

  /* Splitter zone: drag to change panel widths */
  .splitter {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    cursor: col-resize;
    touch-action: none;
  }

  .splitter:hover {
    background: var(--accent-soft);
  }

  .splitter-dots {
    display: flex;
    flex-direction: column;
    gap: 4px;
    pointer-events: none;
  }

  .splitter-dots i {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--on-surface-tertiary);
  }

  @media (max-width: 1023px) {
    .workspace {
      grid-template-columns: 1fr !important;
      grid-template-rows: minmax(240px, 1fr) auto minmax(240px, 1fr);
    }

    .middle {
      flex-direction: row;
      align-items: center;
      border-left: 0;
      border-right: 0;
      border-top: 1px solid var(--separator);
      border-bottom: 1px solid var(--separator);
      padding: 8px;
      gap: 8px;
    }

    .middle-controls {
      flex: 1;
      flex-direction: row;
      justify-content: space-around;
      padding: 0;
      gap: 8px;
    }

    .ctl-group {
      width: auto;
    }

    .ctl-label {
      display: none;
    }

    .compare {
      width: auto;
    }

    .ad-group {
      display: none;
    }

    .splitter {
      display: none;
    }
  }
</style>

<script>
  import { initWorkspace } from '../scripts/workspace';

  initWorkspace();
</script>
