---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Workspace from '../components/Workspace.astro';
import AdSlot from '../components/AdSlot.astro';
import { ads } from '../config/ads';
---

<Layout>
  <div class="page">
    <Navbar />
    {ads.placements['top-leaderboard'] && <AdSlot variant="top-leaderboard" />}
    <main class="workspace-area">
      <Workspace />
    </main>
    {ads.placements.footer && <AdSlot variant="footer" />}
    {ads.placements.sidebar && <AdSlot variant="sidebar" />}
    <footer class="page-footer">
      <h1 class="sr-only">JSON Formatter &amp; Validator Online — Free, Client-Side</h1>
      <p>
        Free client-side JSON formatter and validator — format, validate and view JSON as
        text, tree or table. Everything runs in your browser; your data never leaves your
        device.
      </p>
    </footer>
  </div>
</Layout>

<style>
  .page {
    display: flex;
    flex-direction: column;
    height: 100dvh;
  }

  .workspace-area {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-height: 0;
  }

  /* Reserve a right rail when the sidebar ad is enabled */
  .page:has(.ad-sidebar) {
    padding-right: 176px;
  }

  @media (max-width: 1599px) {
    .page:has(.ad-sidebar) {
      padding-right: 0;
    }
  }

  /* Page footer: one-line product description (DESIGN.md → page-footer). */
  .page-footer {
    padding: 4px 16px 12px;
    text-align: center;
  }

  .page-footer p {
    max-width: 720px;
    margin: 0 auto;
    font-size: 13px; /* footnote */
    line-height: 18px;
    color: var(--on-surface-secondary);
  }
</style>
