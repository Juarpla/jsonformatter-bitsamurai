---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Workspace from '../components/Workspace.astro';
import AdSlot from '../components/AdSlot.astro';
import { ads } from '../config/ads';
---

<Layout>
  <div class="page">
    <Navbar />
    <main class="workspace-area">
      <Workspace />
    </main>
    {ads.placements.footer && <AdSlot variant="footer" />}
    <footer class="page-footer">
      <h1 class="sr-only">JSON Formatter &amp; Validator Online — Free, Client-Side</h1>
      <p class="sr-only">
        Free client-side JSON formatter and validator — format, validate and view JSON as
        text, tree or table. Everything runs in your browser; your data never leaves your
        device.
      </p>
    </footer>
  </div>
</Layout>

<style>
  .page {
    display: flex;
    flex-direction: column;
    height: 100dvh;
  }

  .workspace-area {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-height: 0;
  }

</style>
